# การตั้งค่าสำหรับสรุปเอกสารด้วย AI
# คัดลอกไฟล์นี้เป็น .env ที่รากโปรเจกต์ แล้วแก้ค่าตามต้องการ
# ค่าที่ตั้งเป็น environment variable จริงจะมีผลก่อนค่าในไฟล์นี้

# ที่อยู่ API ของผู้ให้บริการ (ตัวอย่างนี้เป็น API แบบ OpenAI-compatible ที่ต้องใช้คีย์)
OCR_LLM_URL=https://api.tokenme.limited/api/v1
# ชื่อโมเดลที่ใช้สรุปเอกสาร
OCR_LLM_MODEL=unsloth/qwen3.8-27b-nvfp4
# คีย์ API ของผู้ให้บริการ ใส่คีย์ของคุณเอง และอย่า commit ไฟล์ .env ขึ้น git
OCR_LLM_API_KEY=
# ค่า reasoning_effort ที่ส่งไปให้โมเดล ค่าว่างคือไม่ส่งค่านี้
OCR_LLM_REASONING_EFFORT=none

# ข้อควรทราบ: ผู้ให้บริการภายนอกจะได้รับข้อความ OCR ของทุกเอกสารที่ถูกสรุป
# ถ้าไม่ต้องการส่งข้อความออกนอกเครื่อง ให้ใช้ LM Studio ในเครื่องแทนด้านล่าง

# ทางเลือก: LM Studio ในเครื่อง (ไม่ต้องใช้คีย์)
# OCR_LLM_URL=http://localhost:1235/v1
# OCR_LLM_MODEL=unsloth/qwen3.5-4b
# OCR_LLM_API_KEY=
